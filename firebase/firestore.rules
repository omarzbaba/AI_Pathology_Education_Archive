// Firestore security rules — AI in Pathology Education Companion Library
//
// Deploy with:  firebase deploy --only firestore:rules
//
// SECURITY MODEL
// --------------
// access_log:
//   create  — allowed for anyone whose request passes App Check AND
//             whose payload matches the required document shape.
//   read    — allowed only when request.auth.uid == ADMIN_UID.
//   list    — same as read.
//   update  — denied for everyone, including the admin.  Append-only.
//   delete  — denied for everyone, including the admin.  Append-only.
//
// All other collections deny all access by default.
//
// App Check enforcement (configured in the Firebase console, not in
// these rules) blocks requests without a valid App Check token BEFORE
// these rules are even evaluated. That defends the create-allowed
// endpoint against bots and scraped-config abuse.
//
// PLACEHOLDERS (filled in during Phase 3 console walkthrough):
//   ADMIN_UID  — the Firebase Auth UID of the single admin user.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'gXIEl0ajRzfXHgUye54WvemBf642';
    }

    function isValidAccessLogPayload() {
      let data = request.resource.data;
      let keys = data.keys();
      let required = [
        'timestamp', 'name', 'institution',
        'email', 'role', 'referrer', 'user_agent'
      ];
      let allowedRoles = [
        'resident', 'fellow', 'faculty',
        'program_director', 'other'
      ];

      return
        // exact key set — reject any extra fields
        keys.hasAll(required) && keys.hasOnly(required)

        // server-set timestamp only — clients cannot backdate
        && data.timestamp == request.time

        // shape & length caps
        && data.name        is string && data.name.size() >= 1   && data.name.size() <= 120
        && data.institution is string && data.institution.size() <= 200
        && data.email       is string && data.email.size() >= 5  && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.role        is string && data.role in allowedRoles
        && data.referrer    is string && data.referrer.size() <= 500
        && data.user_agent  is string && data.user_agent.size() <= 500;
    }

    // ---- access_log ----

    match /access_log/{docId} {
      allow create:        if isValidAccessLogPayload();
      allow read, list:    if isAdmin();
      allow update, delete: if false;
    }

    // ---- prompt_submissions ----
    //
    // Community-contributed prompt submissions.
    // - create: anyone (via App Check) with valid payload shape
    // - read/list: admin only
    // - update: admin only, and limited to status/review fields
    //   (the submitted content itself is immutable to preserve audit trail)
    // - delete: never

    function isValidSubmissionPayload() {
      let d = request.resource.data;
      let keys = d.keys();
      let required = [
        'timestamp', 'status',
        'submitter_name', 'submitter_email', 'submitter_affiliation',
        'prompt_title', 'prompt_pillar', 'prompt_audience',
        'prompt_difficulty', 'prompt_time',
        'prompt_intent', 'prompt_when', 'prompt_text',
        'prompt_expected_output', 'prompt_failure_modes', 'prompt_verification',
        'prompt_best_model',
        'referrer', 'user_agent'
      ];
      let allowedPillars = ['self-education', 'teaching', 'educational-operations'];
      let allowedAudiences = ['resident', 'fellow', 'faculty', 'program-director', 'learner', 'mixed', ''];
      let allowedDifficulties = ['quick-win', 'intermediate', 'advanced', ''];
      let allowedTimes = ['<2min', '2-10min', '>10min', ''];

      return
        keys.hasAll(required) && keys.hasOnly(required)
        && d.timestamp == request.time
        && d.status == 'pending'
        // Submitter fields
        && d.submitter_name is string && d.submitter_name.size() >= 1 && d.submitter_name.size() <= 120
        && d.submitter_email is string && d.submitter_email.size() >= 5 && d.submitter_email.size() <= 254
        && d.submitter_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.submitter_affiliation is string && d.submitter_affiliation.size() <= 200
        // Prompt basics
        && d.prompt_title is string && d.prompt_title.size() >= 1 && d.prompt_title.size() <= 200
        && d.prompt_pillar is string && d.prompt_pillar in allowedPillars
        && d.prompt_audience is string && d.prompt_audience in allowedAudiences
        && d.prompt_difficulty is string && d.prompt_difficulty in allowedDifficulties
        && d.prompt_time is string && d.prompt_time in allowedTimes
        // Content fields
        && d.prompt_intent is string && d.prompt_intent.size() >= 20 && d.prompt_intent.size() <= 800
        && d.prompt_when is string && d.prompt_when.size() <= 800
        && d.prompt_text is string && d.prompt_text.size() >= 50 && d.prompt_text.size() <= 8000
        && d.prompt_expected_output is string && d.prompt_expected_output.size() <= 800
        && d.prompt_failure_modes is string && d.prompt_failure_modes.size() <= 1500
        && d.prompt_verification is string && d.prompt_verification.size() <= 1500
        && d.prompt_best_model is string && d.prompt_best_model.size() <= 100
        // Diagnostic fields
        && d.referrer is string && d.referrer.size() <= 500
        && d.user_agent is string && d.user_agent.size() <= 500;
    }

    function isAdminStatusUpdate() {
      // Admin can update ONLY status and review_notes / reviewed_at;
      // all other fields must remain unchanged.
      let before = resource.data;
      let after = request.resource.data;
      let allowedStatuses = ['pending', 'approved', 'rejected', 'needs_revision'];
      let immutable = [
        'timestamp',
        'submitter_name', 'submitter_email', 'submitter_affiliation',
        'prompt_title', 'prompt_pillar', 'prompt_audience',
        'prompt_difficulty', 'prompt_time',
        'prompt_intent', 'prompt_when', 'prompt_text',
        'prompt_expected_output', 'prompt_failure_modes', 'prompt_verification',
        'prompt_best_model',
        'referrer', 'user_agent'
      ];
      // No immutable field is being modified
      let allImmutableUnchanged = immutable.hasAll(immutable) &&
        !(before.diff(after).affectedKeys().hasAny(immutable));
      // Status must be a valid value
      let validStatus = after.status is string && after.status in allowedStatuses;
      return allImmutableUnchanged && validStatus;
    }

    match /prompt_submissions/{docId} {
      allow create:        if isValidSubmissionPayload();
      allow read, list:    if isAdmin();
      allow update:        if isAdmin() && isAdminStatusUpdate();
      allow delete:        if isAdmin();
    }

    // ---- comments ----
    //
    // Community comments on prompts.
    // - create: anyone with App Check + valid shape. Starts as 'pending';
    //   admin moderates before public visibility.
    // - read/list: anyone can read VISIBLE comments. Pending/hidden are
    //   admin-only.
    // - update: admin only (status changes; can also write admin replies
    //   with is_admin=true via separate creates).
    // - delete: never (hide instead, preserve audit trail).

    function isValidCommentPayload() {
      let d = request.resource.data;
      let keys = d.keys();
      let required = [
        'timestamp', 'status',
        'prompt_path',
        'commenter_name', 'commenter_email', 'commenter_affiliation',
        'comment_text',
        'is_admin', 'referrer', 'user_agent'
      ];
      let allowedStatuses = ['pending', 'visible', 'hidden'];

      return
        keys.hasAll(required) && keys.hasOnly(required)
        && d.timestamp == request.time
        // Public-created comments start as 'pending' (admin moderates).
        // Admin-created comments (is_admin=true) can start as 'visible'.
        && (
          (d.status == 'pending' && d.is_admin == false)
          || (isAdmin() && d.status == 'visible' && d.is_admin == true)
        )
        && d.prompt_path is string && d.prompt_path.size() >= 1 && d.prompt_path.size() <= 300
        && d.prompt_path.matches('^[A-Za-z0-9_/\\-]+$')
        && d.commenter_name is string && d.commenter_name.size() >= 1 && d.commenter_name.size() <= 100
        && d.commenter_email is string && d.commenter_email.size() >= 5 && d.commenter_email.size() <= 254
        && d.commenter_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.commenter_affiliation is string && d.commenter_affiliation.size() <= 200
        && d.comment_text is string && d.comment_text.size() >= 10 && d.comment_text.size() <= 2000
        && d.is_admin is bool
        && d.referrer is string && d.referrer.size() <= 500
        && d.user_agent is string && d.user_agent.size() <= 500;
    }

    function isAdminCommentUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let allowedStatuses = ['pending', 'visible', 'hidden'];
      let immutable = [
        'timestamp', 'prompt_path',
        'commenter_name', 'commenter_email', 'commenter_affiliation',
        'comment_text', 'is_admin', 'referrer', 'user_agent'
      ];
      return
        !(before.diff(after).affectedKeys().hasAny(immutable))
        && after.status is string && after.status in allowedStatuses;
    }

    match /comments/{docId} {
      allow create:        if isValidCommentPayload();
      allow read, list:    if isAdmin() || resource.data.status == 'visible';
      allow update:        if isAdmin() && isAdminCommentUpdate();
      allow delete:        if isAdmin();
    }

    // ---- votes ----
    //
    // Upvotes on prompts. One vote per email per prompt enforced by
    // deterministic doc ID (prompt_path__email_hash).
    // - create: anyone with App Check + valid shape. Existing doc at same
    //   ID means "already voted"; client should not re-write.
    // - read/list: anyone can read aggregate counts (count of vote docs
    //   per prompt_path).
    // - update: nobody (votes are immutable; you either voted or you
    //   didn't).
    // - delete: client can delete their own vote (un-vote) ONLY if the
    //   voter_email matches what they submit. (Note: this is a courtesy
    //   gate; full deletion-by-non-owner protection requires Firebase
    //   Auth, which we don't require for voting.)

    function isValidVotePayload() {
      let d = request.resource.data;
      let keys = d.keys();
      let required = [
        'timestamp', 'prompt_path', 'voter_email',
        'referrer', 'user_agent'
      ];
      return
        keys.hasAll(required) && keys.hasOnly(required)
        && d.timestamp == request.time
        && d.prompt_path is string && d.prompt_path.size() >= 1 && d.prompt_path.size() <= 300
        && d.prompt_path.matches('^[A-Za-z0-9_/\\-]+$')
        && d.voter_email is string && d.voter_email.size() >= 5 && d.voter_email.size() <= 254
        && d.voter_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.referrer is string && d.referrer.size() <= 500
        && d.user_agent is string && d.user_agent.size() <= 500;
    }

    match /votes/{docId} {
      allow create:        if isValidVotePayload();
      allow read, list:    if true;
      allow update:        if false;
      allow delete:        if isAdmin();
    }

    // ---- feedback ----
    //
    // Free-form feedback / bug reports / suggestions from any visitor.
    // - create: anyone with App Check + valid shape. Identity is optional
    //   (anonymous feedback allowed); if present, must be valid email.
    // - read/list/update/delete: admin only.

    function isValidFeedbackPayload() {
      let d = request.resource.data;
      let keys = d.keys();
      let required = [
        'timestamp', 'status',
        'submitter_name', 'submitter_email',
        'message', 'page_url',
        'referrer', 'user_agent'
      ];
      return
        keys.hasAll(required) && keys.hasOnly(required)
        && d.timestamp == request.time
        && d.status == 'new'
        && d.submitter_name is string && d.submitter_name.size() <= 120
        && d.submitter_email is string && d.submitter_email.size() <= 254
        && (d.submitter_email.size() == 0
            || d.submitter_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && d.message is string && d.message.size() >= 10 && d.message.size() <= 3000
        && d.page_url is string && d.page_url.size() <= 500
        && d.referrer is string && d.referrer.size() <= 500
        && d.user_agent is string && d.user_agent.size() <= 500;
    }

    function isAdminFeedbackUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let allowedStatuses = ['new', 'triaged', 'resolved'];
      let immutable = [
        'timestamp',
        'submitter_name', 'submitter_email',
        'message', 'page_url',
        'referrer', 'user_agent'
      ];
      return
        !(before.diff(after).affectedKeys().hasAny(immutable))
        && after.status is string && after.status in allowedStatuses;
    }

    match /feedback/{docId} {
      allow create:        if isValidFeedbackPayload();
      allow read, list:    if isAdmin();
      allow update:        if isAdmin() && isAdminFeedbackUpdate();
      allow delete:        if isAdmin();
    }

    // ---- deny-by-default for everything else ----

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
